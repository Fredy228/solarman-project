      "question": "Какая мощность вас интересует?",
      "required": true,
      "defaultOptionId": "up-to-5",
      "options": [
        { "id": "up-to-5", "label": "до 5 кВт", "mobileLabel": "5 кВт", "value": 5 },
        { "id": "up-to-10", "label": "до 10 кВт", "mobileLabel": "10 кВт", "value": 10 },
        { "id": "up-to-20", "label": "до 20 кВт", "mobileLabel": "20 кВт", "value": 20 },
        { "id": "up-to-30", "label": "до 30 кВт", "mobileLabel": "30 кВт", "value": 30 },
        { "id": "more-than-30", "label": "больше 30 кВт", "mobileLabel": "30+ кВт", "value": 31 }
      ]
    },
    {
      "id": "city",
      "module": "text-options",
      "question": "Укажите ваш город",
      "required": true,
      "options": [
        { "id": "odesa", "title": "Одесса" },
        { "id": "mykolaiv", "title": "Николаев" },
        { "id": "region", "title": "Область" },
        {
          "id": "other",
          "title": "Другое",
          "input": {
            "id": "city",
            "placeholder": "Укажите ваш город",
            "required": true,
            "maxLength": 100
          }
        }
      ]
    },
    {
      "id": "contacts",
      "module": "contact-form",
      "question": "Укажите имя и номер телефона",
