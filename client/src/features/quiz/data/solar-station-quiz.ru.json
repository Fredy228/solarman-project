      "fields": [
        {
          "id": "name",
          "label": "Ваше имя",
          "placeholder": "Ваше имя",
          "inputType": "text",
          "required": true,
          "maxLength": 100
        },
        {
          "id": "phone",
          "label": "Ваш номер телефона",
          "placeholder": "Ваш номер телефона",
          "inputType": "tel",
          "required": true
        }
      ]
    }
