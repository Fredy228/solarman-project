# Docker compose environment. To change the environment to development,
COMPOSE_PROJECT_NAME=solarman
COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml:docker-compose-proxy.yml

# --- Ports ---
PORT_CLIENT=3000
PORT_SERVER=3002
# --- Only for docker ---
NGINX_PORT=80
NGINX_SSL_PORT=443
# --- ---

# --- NextJS setting ---
NEXT_PUBLIC_SERVER_PROTOCOL='http'
NEXT_PUBLIC_SERVER_HOST='localhost'

# CORS Origin for server
# list comma-separated, no space, can be empty
CORS_ORIGIN=http://localhost

DB_HOST='db'
DB_USER=''
DB_PASSWORD=''
DB_NAME=''
DB_PORT=27017
DATABASE_URL="mongodb://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?retryWrites=true&w=majority&authSource=admin&replicaSet=rs0&directConnection=true"
DB_EXTERNAL_PORT=27017

# --- JWT settings ---
JWT_SECRET='SECRET_STRING'
JWT_EXPIRE_ACCESS_TOKEN='1d'
JWT_EXPIRE_REFRESH_TOKEN='7d'
# --- ---

# Bcrypt salt round, number
SALT_ROUNDS=20

# Cookie expire, miliseconds
# Day*Hour*Minute*Second*Milisecond
COOKIES_EXPIRE=604800000

# SSL cert for nginx
# Only for docker
PATH_SSL_FOLDER=

URL_KEY_CRM="https://openapi.keycrm.app"
TOKEN_KEY_CRM=""
SOURCES_KEY_CRM="google:1,fb-insta:2,custom-p:5,google-p:6"

TELEGRAM_TOKEN=""
TELEGRAM_CHAT_ID=""

DEFAULT_ADMIN_EMAIL=""
DEFAULT_ADMIN_PASS=""
