model Goods {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  tag         String           @unique
  title       LocalizedContent
  description LocalizedContent

  category      GoodsCategory
  price         Int
  discountPrice Int?
  currency      ECurrency
  specs         Json?
  badge         BadgeType?
  country       String?

  instructions PdfInfo[]
  images       String[]  @default([])
  cover        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand   GoodsBrand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  brandId String?     @db.ObjectId

  @@map("goods")
}

type PdfInfo {
  fileName String
  filePath String
}

enum ECurrency {
  USD
  EUR
  UAH
}

enum BadgeType {
  SALE
  LOW_STOCK
  PRICE_INCREASE_PLANNED
}

enum GoodsCategory {
  PANEL
  INVERTOR
  BATTERY
  FASTENER
  COMPONENT
  CHARGE_STATION
  READY_MADE_SOLUTION
}
