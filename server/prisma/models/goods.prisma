model Goods {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  tag         String           @unique
  title       LocalizedContent
  description LocalizedContent

  category     GoodsCategory
  price        Int
  specs        Json?
  instructions PdfInfo[]

  cover String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country String?

  brand   GoodsBrand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  brandId String?     @db.ObjectId

  @@map("goods")
}

type PdfInfo {
  fileName String
  filePath String
}

enum GoodsCategory {
  PANEL
  INVERTOR
  BATTERY
  FASTENER
  COMPONENT
  CHARGE_STATION
  READY_MADE_SOLUTION
}
